"$schema" = "https://starship.rs/config-schema.json"

add_newline = true
command_timeout = 1200
palette = "pjc"

format = """
$username$hostname$directory$git_branch$git_status$git_metrics$fill$nodejs$java$python$cmd_duration$status$jobs$time
$character"""

[fill]
symbol = " "

[username]
show_always = false
style_user = "bold fg:teal"
style_root = "bold fg:red"
format = "[$user]($style) "

[hostname]
ssh_only = true
style = "fg:yellow"
format = "[@$hostname]($style) "

[directory]
style = "bold fg:blue"
read_only = " ro"
read_only_style = "fg:red"
truncation_length = 4
truncate_to_repo = false
format = "[$path]($style)[$read_only]($read_only_style) "

[directory.substitutions]
{{ .chezmoi.homeDir | quote }} = "~"
{{ printf "%s/work/c_project/ares-omc" .chezmoi.homeDir | quote }} = "omc"
{{ printf "%s/.codex" .chezmoi.homeDir | quote }} = "codex"
{{ printf "%s/.memory-palace" .chezmoi.homeDir | quote }} = "memory"

[git_branch]
symbol = "git:"
style = "fg:mauve"
format = "[$symbol$branch]($style) "

[git_status]
style = "fg:yellow"
format = "([$all_status$ahead_behind]($style) )"
conflicted = "=${count} "
ahead = "+${count} "
behind = "-${count} "
diverged = "+${ahead_count}-${behind_count} "
up_to_date = ""
untracked = "?${count} "
stashed = "stash "
modified = "!${count} "
staged = "+${count} "
renamed = "renamed "
deleted = "x${count} "

[git_metrics]
disabled = false
added_style = "fg:green"
deleted_style = "fg:red"
format = "([+$added]($added_style) [-$deleted]($deleted_style) )"

[nodejs]
symbol = "node "
style = "fg:green"
format = "[$symbol$version]($style) "
detect_extensions = ["js", "mjs", "cjs", "ts", "tsx", "jsx", "vue"]
detect_files = ["package.json", ".node-version", ".nvmrc", "pnpm-lock.yaml", "vite.config.ts"]
detect_folders = []

[java]
symbol = "java "
style = "fg:peach"
format = "[$symbol$version]($style) "
detect_extensions = ["java", "class", "gradle", "jar", "clj", "kt", "kts"]
detect_files = ["pom.xml", "build.gradle", "build.gradle.kts", ".java-version"]
detect_folders = []

[python]
symbol = "py "
style = "fg:green"
format = "[$symbol$version( $virtualenv)]($style) "
detect_extensions = ["py"]
detect_files = ["pyproject.toml", "requirements.txt", ".python-version", "uv.lock"]
detect_folders = []

[cmd_duration]
min_time = 800
show_milliseconds = false
style = "fg:subtext"
format = "[took $duration]($style) "

[status]
disabled = false
style = "fg:red"
symbol = "exit "
format = "[$symbol$status]($style) "

[jobs]
symbol = "jobs "
style = "fg:yellow"
format = "[$symbol$number]($style) "

[time]
disabled = false
time_format = "%H:%M"
style = "fg:subtext"
format = "[$time]($style)"

[character]
success_symbol = "[❯](bold fg:teal)"
error_symbol = "[❯](bold fg:red)"
vimcmd_symbol = "[❮](bold fg:teal)"
vimcmd_replace_one_symbol = "[❮](bold fg:peach)"
vimcmd_replace_symbol = "[❮](bold fg:peach)"
vimcmd_visual_symbol = "[❮](bold fg:yellow)"

[palettes.pjc]
blue = "#4c7dff"
green = "#5cae72"
mauve = "#9d7cd8"
peach = "#d48a55"
red = "#d85f68"
teal = "#2d9d93"
yellow = "#c69a3d"
subtext = "#7d8078"
