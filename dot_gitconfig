[alias]
	logs = log --pretty=format:'%C(yellow)%h%Creset - %Cgreen%an%Creset(%ar) : %s' --no-merges
	prune-gone = !git branch -vv | grep ': gone]' | awk '{print $1}' | xargs git branch -d
	s = status
	co = checkout
	cm = commit -m
	aa = add .
	pl = pull
	ps = push
	lg = log --oneline --graph --decorate
	l = log --oneline -10
	ba = branch -a
	cb = checkout -b
	brvv = branch -vv
	unstage = reset HEAD --
	undo = checkout --
	soft = reset --soft HEAD^
	rpo = remote prune origin
	fap = fetch --all --prune
	fo = fetch origin
	fcp = "!f() { git fetch origin && git cherry-pick \"$@\"; }; f"
[core]
	pager = delta
	quotepath = false
	longpaths = true
	autocrlf = input
	trustctime = false
	ignorecase = false
	untrackedcache = true
	excludesfile = ~/.gitignore_global
[delta]
	# 默认上下对比，避免窄窗口将长行拆成左右两栏。
	line-numbers = true
	side-by-side = false
	keep-plus-minus-markers = true
	minus-style = syntax auto
	plus-style = syntax auto
	minus-emph-style = syntax bold auto
	plus-emph-style = syntax bold auto
	file-style = yellow bold
	file-decoration-style = yellow ul
	navigate = true
	dark = true
[interactive]
	difffilter = delta --color-only
[merge]
	conflictstyle = zdiff3
[pull]
	rebase = false
	autostash = true
[init]
	defaultbranch = master
[diff "text"]
	textconv = cat
[mergetool]
	keepbackup = false
[lfs]
	concurrenttransfers = 16
	fetchrecentrefsdays = 0
	pruneoffsetdays = 0
	dialtimeout = 3
	tlstimeout = 3
[lfs "transfer"]
	maxretries = 1
	maxretrydelay = 2
[merge "lfs-text"]
	driver = git lfs merge-driver --ancestor %O --current %A --other %B --marker-size %L --output %A --program 'git merge-file --stdout --marker-size=%%L %%A %%O %%B >%%D'
[rebase]
	backend = merge
[protocol]
	version = 1
[user]
	useConfigOnly = true
[include]
	path = ~/.gitconfig.local
