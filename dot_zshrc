# ==============================================
# ~/.zshrc
# 主入口，只负责加载各模块
# ==============================================

# 1. 环境变量 / PATH（必须最早）
source "$HOME/.config/zsh/env.zsh"
# 本机 PATH、代理和工具开关必须在工具初始化前生效。
[[ -r "$HOME/.config/zsh/env.local.zsh" ]] && source "$HOME/.config/zsh/env.local.zsh"

# 2. 历史记录
source "$HOME/.config/zsh/history.zsh"

# 3. oh-my-zsh（必须在插件/别名之前）
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
ZSH_THEME="${ZSH_THEME:-}"
(( ${+plugins} )) || plugins=(git)
# Oh My Zsh 可选；插件由 Homebrew 加载，zoxide 只在 tools.zsh 初始化。
[[ -r "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# 4. 工具初始化（starship/zoxide/mise/fzf）
source "$HOME/.config/zsh/tools.zsh"

# 5. 别名
source "$HOME/.config/zsh/aliases.zsh"

# 6. 函数
source "$HOME/.config/zsh/functions.zsh"

# 7. 本机别名和函数最后覆盖通用默认值。
[[ -r "$HOME/.config/zsh/local.zsh" ]] && source "$HOME/.config/zsh/local.zsh"

# 本机 PATH 接线完成后才激活原生 shims，避免执行前 hook 再次抢占 PATH。
# 项目运行时仍由 mise.toml 选择；项目环境变量用 mise exec 显式加载。
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh --shims)"
fi

# 语法高亮需在全部 widgets/函数定义后加载。
if [[ -n "${HOMEBREW_PREFIX:-}" ]]; then
  ZSH_AUTOSUGGEST_STRATEGY=(${ZSH_AUTOSUGGEST_STRATEGY:-history})
  : "${ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE:=fg=8}"
  : "${ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE:=30}"
  export YSU_MESSAGE_POSITION="${YSU_MESSAGE_POSITION:-before}"
  export YSU_MODE="${YSU_MODE:-ALL}"
  for plugin_file in \
    "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
    "$HOMEBREW_PREFIX/share/zsh-you-should-use/you-should-use.plugin.zsh" \
    "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"; do
    [[ -r "$plugin_file" ]] && source "$plugin_file"
  done
  unset plugin_file
fi
