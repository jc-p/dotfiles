# 按需编辑后，通过 scripts/bootstrap.sh --optional 显式安装。
brew "lazygit"
brew "gh"
brew "wget"
brew "curl"
brew "tree"
brew "tmux"
brew "coreutils"
brew "gnu-sed"
brew "grep"
brew "git-delta"  # Homebrew 的包名为 git-delta，命令名为 delta。
brew "tldr"
brew "zsh-you-should-use"  # 已安装时按原顺序加载，不作为必需依赖。

if OS.mac?
  cask "font-hack-nerd-font"
end
